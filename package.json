  "main": "index.ts",
  "license": "MIT",
  "author": "Eric Qian",
  "homepage": "https://github.com/freeyoung/pi-tokrate#readme",
  "bugs": "https://github.com/freeyoung/pi-tokrate/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freeyoung/pi-tokrate.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "tokens",
    "throughput",
    "tps",
    "reasoning",
    "statusline"
  ],
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
